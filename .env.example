# Shopify Storefront API Configuration
# Replace these placeholders with your actual store details

SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Webhook Revalidation Secret (Used for instant frontend cache clearing from Shopify Admin)
SHOPIFY_REVALIDATION_SECRET=nakshatra_secret_key

# Shopify Customer Account API (OAuth 2.0)
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=

